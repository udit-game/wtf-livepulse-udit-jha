## .env.example — copy to `.env` and fill in values before running `docker compose up`

######################
# Postgres settings
######################
# Name of the initial database created by the Postgres image
POSTGRES_DB=wtf_livepulse
# Postgres superuser created on init
POSTGRES_USER=wtf
# Password for the Postgres user
POSTGRES_PASSWORD=wtf_secret

######################
# Infrastructure / Compose-level connection string
######################
# Full connection string used by the backend. Example (Docker):
# postgres://wtf:wtf_secret@db:5432/wtf_livepulse
DATABASE_URL=postgres://wtf:wtf_secret@db:5432/wtf_livepulse

######################
# Frontend Vite envs (build-time)
######################
# These are passed to the frontend build. `VITE_API_BASE_URL` should point
# to the backend API path exposed to the browser (often `/api` behind a
# reverse-proxy in Compose). `VITE_WS_URL` is the WebSocket URL the UI will
# connect to.
VITE_API_BASE_URL=/api
VITE_WS_URL=ws://localhost:3001/ws

######################
# Ports exposed on the host
######################
# Host port to map to the backend container (compose enforces this variable)
BACKEND_PORT=3001
# Host port to map to the frontend container
FRONTEND_PORT=3000

######################
# Timezone
######################
# The timezone to configure the DB and to use for app logic. Compose will
# fail if this is missing (infrastructure-level enforcement).
TZ=Asia/Kolkata
# (Optional) Postgres-specific timezone var used in some deployments
PGTZ=Asia/Kolkata

######################
# App / Environment
######################
# NODE_ENV controls app mode
NODE_ENV=development
# Backend app timezone (used by JS logic). If unset, `TZ` is used by Compose
# and the init script will apply it to Postgres.
APP_TIMEZONE=Asia/Kolkata
